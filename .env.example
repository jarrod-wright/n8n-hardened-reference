# ─────────────────────────────────────────────────────────────────────────────
# n8n-hardened-reference — environment (EXAMPLE)
#
# Copy to `.env` and fill in real values. `.env` and everything under `secrets/`
# are gitignored. NEVER commit real hostnames-with-secrets, keys, or passwords.
# ─────────────────────────────────────────────────────────────────────────────

# --- Public hostname (must resolve to THIS server so Caddy can obtain a cert) ---
N8N_HOST=n8n.example.com

# --- ACME account email (Let's Encrypt expiry/recovery notices) ---
ACME_EMAIL=admin@example.com

# --- Timezone (affects Schedule / Cron nodes) ---
GENERIC_TIMEZONE=Etc/UTC

# --- PostgreSQL (non-secret parts; the PASSWORD lives in secrets/, not here) ---
POSTGRES_DB=n8n
POSTGRES_USER=n8n

# --- Redis password (internal-only network, but still set a strong value) ---
# Generate: openssl rand -base64 32
REDIS_PASSWORD=change-me-run-openssl-rand-base64-32

# ─────────────────────────────────────────────────────────────────────────────
# SECRET FILES  (NOT in this file — Docker reads them from ./secrets/*.txt)
# Create them ONCE, before first boot:
#
#   mkdir -p secrets
#   openssl rand -hex 32                       > secrets/n8n_encryption_key.txt
#   openssl rand -base64 36 | tr -d '\n'       > secrets/postgres_password.txt
#   chmod 600 secrets/*.txt
#
# ⚠  n8n_encryption_key is UNRECOVERABLE. If lost, every stored credential
#    becomes undecryptable. Back it up in your password manager immediately.
# ─────────────────────────────────────────────────────────────────────────────
