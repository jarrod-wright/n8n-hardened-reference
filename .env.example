# =============================================================================
# n8n-hardened-reference - environment (EXAMPLE)
#
# Copy to `.env` and fill in real values. `.env` and everything under `secrets/`
# are gitignored. NEVER commit real hostnames-with-secrets, keys, or passwords.
# =============================================================================

# --- Public hostname (must resolve to THIS server so Caddy can obtain a cert) ---
N8N_HOST=n8n.example.com

# --- ACME account email (Let's Encrypt expiry / recovery notices) ---
ACME_EMAIL=admin@example.com

# --- Timezone (affects Schedule / Cron nodes) ---
GENERIC_TIMEZONE=Etc/UTC

# --- PostgreSQL ---
# Superuser (admin) - used only for cluster init + healthcheck:
POSTGRES_USER=postgres
POSTGRES_DB=n8n
# Non-root application user that n8n actually connects as
# (created by postgres/init-data.sh on first boot):
POSTGRES_NON_ROOT_USER=n8n

# --- Redis password (internal-only network, but still set a strong value) ---
# Generate: openssl rand -base64 32
REDIS_PASSWORD=change-me-run-openssl-rand-base64-32

# --- Task runners (ONLY needed for the external-mode overlay: make deploy-runners) ---
# Shared secret between the n8n brokers and the runner sidecars.
# Generate: openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=change-me-run-openssl-rand-hex-32

# =============================================================================
# SECRET FILES  (NOT in this file - Docker reads them from ./secrets/*.txt)
# Create them ONCE, before first boot (or run: make init-secrets):
#
#   mkdir -p secrets
#   openssl rand -hex 32                  > secrets/n8n_encryption_key.txt
#   openssl rand -base64 36 | tr -d '\n'  > secrets/postgres_password.txt            # superuser
#   openssl rand -base64 36 | tr -d '\n'  > secrets/postgres_non_root_password.txt   # n8n app user
#   chmod 600 secrets/*.txt
#
# WARNING: n8n_encryption_key is UNRECOVERABLE. If lost, every stored credential
#          becomes undecryptable. Back it up in your password manager immediately.
# =============================================================================
